# ─────────────────────────────────────────────────────────────────────────────
# Carousel Maker configuration. Everything here is optional: with none of it set,
# the app runs the free keyless tier (template writer + Wikipedia). Copy this to
# .env.local and fill in only the mode you want. See docs/PROVIDERS.md for the
# full picture of "brains" and how they compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode 1 & 2 · Claude (bring-your-own-key, or the hosted server key) ──────────
# The key the app writes with. Takes precedence over any ANTHROPIC_API_KEY already
# in the environment, which Next.js will NOT override from a .env file.
# Set this and you get Claude-quality decks with live web search.
CAROUSEL_API_KEY=sk-ant-...

# Falls back to this if CAROUSEL_API_KEY is unset.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used for research + copywriting.
CAROUSEL_MODEL=claude-sonnet-5

# ── Mode 5 · Open-source / hosted-OSS brain (OpenAI-compatible) ─────────────────
# Any OpenAI-compatible chat endpoint: Groq, Together, OpenRouter, Fireworks, a
# local Ollama, or OpenAI itself. Used only when no Anthropic key is present.
# The base URL must end at the API root that exposes /chat/completions.
# CAROUSEL_OSS_BASE_URL=https://api.groq.com/openai/v1
# CAROUSEL_OSS_MODEL=llama-3.3-70b-versatile
# CAROUSEL_OSS_API_KEY=gsk_...            # omit for a local, keyless Ollama
# CAROUSEL_OSS_LABEL=Llama 3.3 (Groq)     # optional display name in the UI

# ── Mode 3 & 4 · Keyless research source ────────────────────────────────────────
# Which free, keyless source feeds the template and OSS writers when they can't
# search the web themselves. "wikipedia" (one clean source) or "web" (Wikipedia +
# DuckDuckGo, broader). The UI can override this per request.
# CAROUSEL_RESEARCH_SOURCE=wikipedia

# ── Spend protection for the hosted server key (Mode 2) ─────────────────────────
# These guard ONLY the modes where we pay (a server Anthropic key, or a hosted OSS
# key). Bring-your-own-key and the keyless template writer are never limited.
# The first limit hit wins. Tune to your budget.
# CAROUSEL_RATE_PER_MIN=5        # per-client burst ceiling
# CAROUSEL_RATE_PER_DAY=50       # per-client daily ceiling
# CAROUSEL_RATE_PER_WEEK=2       # per-client rolling-7-day ceiling (the free-tier cap). Unset = no weekly limit.
# CAROUSEL_DAILY_BUDGET=500      # hard cap on total paid generations per day
# CAROUSEL_RATE_DISABLED=0       # set to 1 to turn the limiter off (e.g. local dev)

# ── Bot shield for the hosted server key (Cloudflare Turnstile) ─────────────────
# Protects the paid /api/generate path from scripts that would drain your embedded
# key. Free from Cloudflare (dash.cloudflare.com → Turnstile → add a widget).
# Leave both unset to disable the challenge (local dev, or a trusted deployment).
# The site key is public (shipped to the browser); the secret key is server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...

# ── Brand ───────────────────────────────────────────────────────────────────────
# The public URL. Used for share-card links and appended to the free-tier caption
# credit ("Typeset by The Carousel Maker … thecarouselmaker.com"). Leave unset
# until the domain actually serves the app — we never print a link that 404s.
# NEXT_PUBLIC_SITE_URL=https://thecarouselmaker.com

# ── Owner-only: auto-post finished carousels to your Instagram ─────────────────
# NEVER set these on the public deploy. With the handle set, the studio shows a
# "Post to @handle" button; the server posts via Composio only to the connection
# whose username matches, and hosts the JPEGs briefly in Supabase Storage
# (uses NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above).
# NEXT_PUBLIC_IG_AUTOPUBLISH_HANDLE=yourhandle
# COMPOSIO_API_KEY=                     # Composio dashboard → Settings → API Keys
# IG_PUBLISH_TOKEN=                     # required if this ever runs in production
