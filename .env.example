# The key this app uses. Set this one — it takes precedence over any
# ANTHROPIC_API_KEY already present in the environment, which Next.js will
# NOT override from a .env file.
CAROUSEL_API_KEY=sk-ant-...

# Falls back to this if CAROUSEL_API_KEY is unset.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used for research + copywriting.
CAROUSEL_MODEL=claude-sonnet-5
