# Copy to `.env.production` on the VPS and fill in ONE engine block.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production — it is git-ignored. docker-compose reads it.
#
# Pick exactly one engine. With none set, the app runs the free keyless tier
# (real facts from Wikipedia/Web, templated wording) — a valid $0 option.

# ── Engine A · Anthropic API (paid, real Claude) ────────────────────────────
# A pay-as-you-go key from console.anthropic.com — NOT a Claude subscription.
# You are billed for every visitor's generation, so keep the budget cap below.
# CAROUSEL_API_KEY=sk-ant-...
# CAROUSEL_MODEL=claude-sonnet-5

# ── Engine B · Free hosted OSS (Groq etc.) — recommended for a public app ───
# Real AI-written copy at ~$0 on a free tier. Any OpenAI-compatible endpoint.
# CAROUSEL_OSS_BASE_URL=https://api.groq.com/openai/v1
# CAROUSEL_OSS_MODEL=llama-3.3-70b-versatile
# CAROUSEL_OSS_API_KEY=gsk_...
# CAROUSEL_OSS_LABEL=Llama 3.3 (Groq)

# ── Keyless research source (used by Engine B and the free tier) ────────────
# CAROUSEL_RESEARCH_SOURCE=wikipedia   # or: web

# ── Spend protection (guards the paid engines only) ─────────────────────────
# The first limit hit wins. Tune to your budget; a public URL invites abuse.
CAROUSEL_RATE_PER_MIN=5
CAROUSEL_RATE_PER_DAY=50
CAROUSEL_DAILY_BUDGET=500
# CAROUSEL_RATE_DISABLED=1   # only for a trusted/private deployment
