# Copy to `.env.production` on the VPS and fill it in.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production — it is git-ignored. docker-compose reads it.
# On Railway, set these as service variables instead; there is no file.
#
# ─────────────────────────────────────────────────────────────────────────────
# THIS FILE IS ENFORCED. It is not a suggestion.
#
# Everything under "Required in production" below is asserted at startup by
# src/instrumentation.ts (contract: src/lib/env/require.ts). With any of them
# missing, the server prints the offending variable names and exits 1 rather
# than serving a single request. GET /api/health reports the same verdict, and
# it is the Railway healthcheck path — so a green deploy means the contract
# passed, not merely that Node is listening.
#
# Why enforced and not checklisted: most of these switches are fail-OPEN when
# unset. That default is right for local dev and for a self-host that opts out,
# and catastrophic for our own public deployment, where it produces a service
# that looks healthy with no weekly cap, no bot shield, and no way to verify a
# payment.
#
# Commit no values here. Placeholders and policy numbers only.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ Required in production ══════════════════════════════════════════════════

# ── Spend + abuse limits ─────────────────────────────────────────────────────
# Unset → perWeek is Infinity: the free tier becomes unlimited and the $9 Maker
# licence has nothing left to sell. Must be a whole number >= 0; a non-numeric
# value is silently discarded back to Infinity, so junk is as bad as blank.
CAROUSEL_RATE_PER_WEEK=2
# Unset → the ceiling on total paid generations per day is whatever the default
# happens to be (500) rather than a number anyone chose. Required so the daily
# spend ceiling is an explicit decision on the record.
CAROUSEL_DAILY_BUDGET=500
# Burst and fair-use ceilings per client. Defaulted, not enforced — but set them.
CAROUSEL_RATE_PER_MIN=5
CAROUSEL_RATE_PER_DAY=50
# MUST NOT be enabled in production. `=1` or `=true` switches off every
# per-client ceiling AND the global daily budget at once. Leave it unset; an
# explicit `=0` is accepted. A production boot with it enabled is refused.
# CAROUSEL_RATE_DISABLED=0

# ── Bot shield on the path that spends our money ─────────────────────────────
# Unset → verifyTurnstile returns ok for every caller ("disabled"), so there is
# no bot shield at all on /api/generate. A loop script then spends our API
# budget at machine speed, with only the rate limiter in its way.
TURNSTILE_SECRET=
# The matching client key. Not startup-enforced — it is a public value baked in
# at build time, so the running server cannot tell whether the widget rendered.
# Without it the browser never produces a token and every server-paid generation
# is rejected. Set it in the BUILD environment too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Licensing ────────────────────────────────────────────────────────────────
# Unset → no licence can be signed or verified: nobody can buy, and nobody who
# has already bought can unlock. Fails closed, so it is safe — just unsellable.
# Use a long random string; rotating it invalidates every licence ever issued.
CAROUSEL_LICENSE_SECRET=
# Unset → the ledger is in memory only. The founding-seat counter resets on
# every deploy, seat numbers repeat, and webhook idempotency is lost — which
# mints a second licence for the same $9 payment on a provider retry. Point this
# at a PERSISTENT volume (Railway: attach a volume and mount it at /data).
CAROUSEL_LICENSE_LEDGER=/data/licences.jsonl
# MUST NOT be set in production. `=1` mints licences for free, with no payment
# at all. It exists so the paid flow can be exercised before Flutterwave keys
# do. A production boot with it present at all is refused.
# CAROUSEL_LICENSE_DEV_UNLOCK=1
# Optional: comma-separated licence ids to refuse at verification (chargebacks).
# CAROUSEL_LICENSE_REVOKED=

# ── Payments (Flutterwave) ───────────────────────────────────────────────────
# Unset → flutterwaveConfigFromEnv returns nothing, so checkout and payment
# verification are both dead and no licence can be sold.
FLW_PUBLIC_KEY=
# Unset → a payment can never be verified server-to-server. A redirect back to
# our site is a claim, not a payment.
FLW_SECRET_KEY=
# Unset → the billing webhook cannot authenticate its caller, and an
# unauthenticated webhook endpoint is a licence printer for anyone who finds the
# URL. Must match the value configured in the Flutterwave dashboard.
FLW_SECRET_HASH=
# Optional override; defaults to the live API.
# FLW_BASE_URL=https://api.flutterwave.com/v3


# ═══ Not enforced, but set them ══════════════════════════════════════════════

# ── Canonical public origin ──────────────────────────────────────────────────
# Absolute URLs in metadata and payment redirects. On Railway,
# RAILWAY_PUBLIC_DOMAIN is the fallback; a custom domain needs this.
# NEXT_PUBLIC_SITE_URL=https://thecarouselmaker.com

# ── Licence delivery email ───────────────────────────────────────────────────
# Without it the licence key is still shown in the browser, just not emailed.
# LICENSE_FROM_EMAIL=licences@thecarouselmaker.com

# ── Generation engine ────────────────────────────────────────────────────────
# Pick exactly one block. With none set, the app runs the free keyless tier
# (real facts from Wikipedia/Web, templated wording) — a valid $0 option, and
# the reason none of these is startup-enforced.

# Engine A · Anthropic API (paid, real Claude)
# A pay-as-you-go key from console.anthropic.com — NOT a Claude subscription.
# You are billed for every visitor's generation, so keep the caps above.
# CAROUSEL_API_KEY=sk-ant-...
# CAROUSEL_MODEL=claude-sonnet-5

# Engine B · Free hosted OSS (Groq etc.) — recommended for a public app
# Real AI-written copy at ~$0 on a free tier. Any OpenAI-compatible endpoint.
# CAROUSEL_OSS_BASE_URL=https://api.groq.com/openai/v1
# CAROUSEL_OSS_MODEL=llama-3.3-70b-versatile
# CAROUSEL_OSS_API_KEY=gsk_...
# CAROUSEL_OSS_LABEL=Llama 3.3 (Groq)

# Keyless research source (used by Engine B and the free tier)
# CAROUSEL_RESEARCH_SOURCE=wikipedia   # or: web
